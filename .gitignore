# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# impeccable: capturas y estado de build son desechables; los hooks por
# herramienta llevan rutas absolutas de esta máquina. PRODUCT.md, DESIGN.md y
# .impeccable/surfaces/ SÍ se versionan: son el contexto que reusa la skill.
.impeccable/review/
.impeccable/build/
.claude/settings.local.json
.codex/
.cursor/
.grok/

# continuidad entre sesiones, nunca se commitea
context.md
